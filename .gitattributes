# Binary 3D assets -> Git LFS. Must be in place BEFORE the first commit of any
# of these, or they land in history as full blobs and stay there.
*.stl filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Deliberately NOT routed: *.png / *.webp. Small doc images are cheaper as
# ordinary blobs than as LFS storage/bandwidth, which is the scarce resource.

# Text
*.md   text eol=lf
*.py   text eol=lf
*.json text eol=lf
